          "description": "Sets the small pre-title above the title."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "value": "",
          "label": "Heading",
          "description": "Sets the main title of the teaser."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "titleType",
          "value": "h3",
